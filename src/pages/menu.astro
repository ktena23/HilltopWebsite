---
import Layout from '../layouts/Layout.astro';import {menu} from '../data/menu.js';
---
<Layout title="Food Menu | Hilltop Restaurant" description="Browse starters, salads, handhelds, house specials, steaks, seafood, pizza and sides at Hilltop Restaurant in Willington, CT."><section class="page-hero menu-page-hero"><div class="container"><img class="inner-page-crest" src="/assets/hilltop-badge.svg" alt="" width="42" height="42" loading="lazy"/><span class="eyebrow">FROM THE GARDEN. FROM THE GRILL.</span><h1>Food Menu</h1><p>Something familiar, something new. Explore our favorites, from starters and handhelds to seafood, steaks, and pizza.</p><a href="/menus/hilltop-food-menu.pdf" class="text-link" target="_blank">Download Food Menu PDF ↗</a></div></section><div class="menu-nav-wrap"><nav class="container menu-nav" aria-label="Food menu categories">{menu.map(section=><a href={'#'+section.id}>{section.name}</a>)}</nav></div><div class="container menu-body">{menu.map(section=><section class="menu-section" id={section.id}><div class="menu-section-title"><span class="eyebrow">HILLTOP RESTAURANT</span><h2>{section.name}</h2></div><div class="menu-items">{section.items.map(item=><article class="menu-item"><div class="item-head"><h3>{item.name}</h3><span class="price">{item.price}</span></div>{item.description&&<p>{item.description}</p>}</article>)}</div>{section.id==='starters'&&<p class="small-note">Wing sauces: Buffalo Mild/Hot, BBQ, Honey Garlic, Sweet Chili, Mango Habanero. Dry rubs: Ranch, Cajun, Jamaican Jerk, Lemon Pepper, Garlic Pepper.</p>}{section.id==='salads'&&<p class="small-note">Add chicken $6 · Ahi tuna $10 · Shrimp $10 · Salmon $12. Dressings: Ranch, Blue Cheese, Italian, Balsamic, Parmesan Peppercorn, Chipotle Ranch, Apple Cider Vinaigrette, Asian Sesame.</p>}{section.id==='handhelds'&&<p class="small-note">Served with French fries or coleslaw unless otherwise indicated. Substitute sweet potato fries or onion rings +$2.</p>}{section.id==='house-specials'&&<p class="small-note">Lunch entrées available Monday–Friday, 11 AM–3 PM. Dinner entrées include soup or salad; upgrade to Caesar +$1.50. Gluten-free pasta +$4.</p>}{(section.id==='chopping-block'||section.id==='from-the-sea')&&<p class="small-note">Add soup, salad or Caesar salad +$2.</p>}</section>)}<p class="small-note disclaimer">Consuming raw or undercooked meats, fish, shellfish, or fresh shell eggs may increase your risk of food-borne illness. Please inform your server of any food allergies before ordering. Substitutions may incur additional charges. Prices and availability are subject to change.</p></div></Layout>
<style>.menu-nav-wrap{background:var(--cream);position:sticky;top:0;z-index:3;border-bottom:1px solid #ddd2c4}.menu-nav{display:flex;gap:25px;overflow:auto;padding:18px 0;scrollbar-width:thin}.menu-nav a{font-size:.75rem;white-space:nowrap;text-transform:uppercase;font-weight:700;letter-spacing:.09em}.menu-nav a:hover{color:var(--walnut)}.menu-body{padding-top:25px;padding-bottom:90px}.menu-section{padding:62px 0;border-bottom:1px solid #d4c7b9;scroll-margin-top:75px}.menu-section-title h2{margin:8px 0 35px}.menu-items{display:grid;grid-template-columns:1fr 1fr;gap:25px 60px}.menu-item{border-bottom:1px solid #e6dcd0;padding-bottom:20px}.item-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px}.item-head h3{font-family:Gloock,Georgia,serif;font-size:1.22rem;font-weight:400;margin:0}.menu-item p{color:#615a53;font-size:.89rem;margin:8px 0 0}.small-note{margin-top:28px}.disclaimer{margin-top:40px}@media(max-width:700px){.menu-items{grid-template-columns:1fr;gap:19px}.menu-section{padding:43px 0}.menu-nav{gap:20px}}</style>

<style>
.menu-page-hero{padding:40px 0 30px}
.menu-page-hero h1{font-size:clamp(2.35rem,4vw,4rem);margin:10px 0 12px}
.menu-page-hero :global(.inner-page-crest){width:32px;height:32px;margin-bottom:12px}
.menu-page-hero p{margin-bottom:14px}
@media(max-width:560px){.menu-page-hero{padding:30px 0 24px}.menu-page-hero h1{font-size:2.5rem}}
</style>

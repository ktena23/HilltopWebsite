---
import Layout from '../layouts/Layout.astro';
import {site} from '../data/site.js';
---
<Layout title="Contact & Visit | Hilltop Restaurant">
  <section class="page-hero"><div class="container"><span class="eyebrow">VISIT US</span><h1>Come see us in Willington.</h1><p>Good food, good company, right at home.</p></div></section>
  <section class="section visit-section"><div class="container visit-grid">
    <div class="visit-primary"><span class="eyebrow">FIND US</span><h2>Hilltop Restaurant</h2><p>39 Adamec Road<br/>Willington, CT 06279</p><p><a href="tel:+18604771054">860-477-1054</a></p><h3>Business Hours</h3><dl class="hours">{site.hours.map(([day,hours])=><div><dt>{day}</dt><dd>{hours}</dd></div>)}</dl><p class="small-note">Bar hours may be extended when business is busy.</p><a class="button" href="https://www.google.com/maps/search/?api=1&query=39+Adamec+Road+Willington+CT" target="_blank" rel="noopener noreferrer">Get Directions ↗</a><p class="banquet-email"><strong>Banquet inquiries:</strong> <a href="mailto:hilltopbanquets@gmail.com">hilltopbanquets@gmail.com</a></p></div>
    <div class="family"><span class="eyebrow">ALSO IN OUR FAMILY</span><div class="family-grid">
      <article class="family-location"><img src="/assets/ellington-oven-red.svg" alt="Ellington Pizza Restaurant emblem" width="72" height="72" loading="lazy"/><h3>Ellington Pizza Restaurant</h3><p>188 Windsorville Road<br/>Ellington, CT 06029</p><a href="tel:+18608723554">860-872-3554</a></article>
      <article class="family-location"><img src="/assets/benis-badge-forest.svg" alt="Beni's Restaurant emblem" width="72" height="72" loading="lazy"/><h3>Beni’s Restaurant</h3><p>1280 Hartford Turnpike<br/>Vernon, CT 06066</p><a href="tel:+18608754443">860-875-4443</a></article>
    </div></div>
  </div></section>
</Layout>
<style>
.visit-section{padding-top:65px}.visit-grid{display:grid;grid-template-columns:1fr 1.12fr;gap:56px}.visit-primary{padding-right:25px}.visit-primary h2{font-size:clamp(1.8rem,3vw,2.7rem);margin:12px 0 20px}.visit-primary h3{font-family:Gloock,Georgia,serif;font-weight:400;font-size:1.55rem;margin:28px 0 12px}.visit-primary p{margin-bottom:16px}.visit-primary a:not(.button),.family-location a{text-decoration:underline;text-underline-offset:3px}.hours{max-width:380px;margin:0}.hours div{display:flex;justify-content:space-between;gap:20px;margin:7px 0}.hours dt,.hours dd{font-size:.91rem;margin:0}.hours dd{text-align:right}.visit-primary .small-note{margin:12px 0 24px}.banquet-email{margin-top:26px;font-size:.88rem}.family{border-left:1px solid #d9ccbd;padding-left:42px}.family-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:25px}.family-location+ .family-location{border-left:1px solid #d9ccbd;padding-left:24px}.family-location img{display:block;object-fit:contain;margin-bottom:15px}.family-location h3{font-family:Gloock,Georgia,serif;font-size:1.35rem;font-weight:400;line-height:1.3;margin-bottom:14px}.family-location p{font-size:.9rem}.family-location a{font-size:.9rem}@media(max-width:850px){.visit-grid{grid-template-columns:1fr;gap:40px}.family{border-left:0;border-top:1px solid #d9ccbd;padding:35px 0 0}.visit-primary{padding-right:0}}@media(max-width:520px){.family-grid{grid-template-columns:1fr}.family-location+.family-location{border-left:0;border-top:1px solid #d9ccbd;padding:22px 0 0}}
</style>

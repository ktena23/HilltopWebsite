---
import Layout from '../layouts/Layout.astro';import {packages,platters} from '../data/banquets.js';
---
<Layout title="Banquets & Private Events | Hilltop Restaurant"><section class="page-hero"><div class="container"><img class="inner-page-crest" src="/assets/hilltop-badge.svg" alt="" width="42" height="42" loading="lazy"/><span class="eyebrow">YOUR CELEBRATION, HANDLED</span><h1>Gather. Celebrate.<br/>Make it memorable.</h1><p>Showers, birthdays, family celebrations, and private gatherings. Explore our banquet options and let us help you plan.</p><div style="display:flex;gap:12px;flex-wrap:wrap"><a href="#inquiry" class="button">Inquire About an Event</a><a href="/menus/hilltop-banquet-packet.pdf" target="_blank" class="button button-outline">Download Banquet Packet ↗</a></div></div></section><section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">OUR PACKAGES</span><h2>Good company, great occasions.</h2><p>Choose the format that suits your celebration. Tax and 20% gratuity are additional to package prices.</p></div><div class="card-grid">{packages.map(pkg=><article class="info-card"><span class="eyebrow">BANQUET PACKAGE</span><h3>{pkg.name}</h3><p><span class="price">{pkg.price}</span> <span class="small-note">{pkg.detail}</span></p><p>{pkg.description}</p><details><summary>View entrée / item choices</summary><ul>{pkg.choices.map(x=><li>{x}</li>)}</ul></details></article>)}</div><p class="small-note">Buffet sides include seasonal vegetables, garlic mashed potatoes, oven-roasted potatoes, rice pilaf, and pasta; additional buffet sides +$3/person each. Full selections are in the downloadable packet.</p></div></section><section class="section" style="background:#eae2d7"><div class="container"><div class="section-heading"><span class="eyebrow">EXTRAS FOR YOUR EVENT</span><h2>Appetizer Platters</h2><p>Each platter serves approximately 15–20 guests and can complement your buffet or plated banquet.</p></div><div class="platter-list">{platters.map(([name,price])=><div class="platter"><span>{name}</span><strong>{price}</strong></div>)}</div></div></section><section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">THE DETAILS</span><h2>Planning your event.</h2></div><div class="feature-grid"><div class="info-card"><h3>Guest Count</h3><p>Minimum 20 guests for the banquet room. Groups of 20–34 use half the room; 35 or more may book the full room, subject to availability.</p></div><div class="info-card"><h3>Reservation & Timing</h3><p>A $150 administrative fee reserves events of 20 or more guests and is not credited to the final bill. Events include three hours; additional time is $50/hour.</p></div><div class="info-card"><h3>Policies</h3><p>The administrative fee is refundable when canceled at least 14 days ahead, otherwise non-refundable. Final menu and guaranteed count due two weeks before the event. Linens: $15 per table.</p></div></div><p class="small-note">Guest count billing is based on the final guaranteed number. Please direct guests to the rear parking lot. Refer to the complete banquet packet for details.</p></div></section><section id="inquiry" class="section" style="background:#f0e9df"><div class="container split"><div><span class="eyebrow">LET'S CELEBRATE</span><h2>Tell us about your event.</h2><p>We'd love to hear what you're planning. For now, the form prepares an email to our banquet team; a direct website submission form can be connected later.</p><p><a class="text-link" href="mailto:hilltopbanquets@gmail.com">hilltopbanquets@gmail.com</a><br/><a href="tel:+18604771054">860-477-1054</a></p></div><form id="event-form" class="form-grid" action="mailto:hilltopbanquets@gmail.com" method="get"><div class="field"><label for="guest-name">Your name</label><input id="guest-name" name="name" required/></div><div class="field"><label for="guest-email">Email</label><input id="guest-email" type="email" name="email" required/></div><div class="field"><label for="guest-phone">Phone</label><input id="guest-phone" type="tel" name="phone"/></div><div class="field"><label for="event-type">Event type</label><input id="event-type" name="eventType" placeholder="Shower, birthday, etc."/></div><div class="field"><label for="event-date">Preferred date</label><input id="event-date" name="date" type="date"/></div><div class="field"><label for="event-guests">Estimated guests</label><input id="event-guests" name="guests" type="number" min="1"/></div><div class="field full"><label for="event-notes">Additional details</label><textarea id="event-notes" name="notes" rows="4"></textarea></div><div class="field full"><button class="button" type="submit">Prepare Email Inquiry ↗</button><span class="small-note">This opens your email application; it does not submit directly to our website.</span></div></form></div></section><script>document.getElementById('event-form')?.addEventListener('submit',e=>{e.preventDefault();const f=e.currentTarget;const d=new FormData(f);const fields=['name','email','phone','eventType','date','guests','notes'];const labels=['Name','Email','Phone','Event type','Preferred date','Estimated guests','Additional details'];const body=fields.map((k,i)=>`${labels[i]}: ${d.get(k)||'Not provided'}`).join('\n');window.location.href=`mailto:hilltopbanquets@gmail.com?subject=${encodeURIComponent('Hilltop banquet inquiry')}&body=${encodeURIComponent(body)}`;});</script></Layout>
<style>.platter-list{display:grid;grid-template-columns:1fr 1fr;gap:0 35px}.platter{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid #cdbdaa;padding:13px 0}.platter strong{color:var(--espresso)}details{margin-top:18px}summary{cursor:pointer;font-weight:700;color:var(--espresso)}details ul{columns:2;padding-left:20px;font-size:.9rem}@media(max-width:700px){.platter-list{grid-template-columns:1fr}details ul{columns:1}}</style>

---
import {site} from '../data/site.js';
const {title='Hilltop Restaurant · Bar · Banquet',description='A welcoming neighborhood restaurant, bar and banquet destination in Willington, Connecticut.'}=Astro.props;
const path=Astro.url.pathname;
const nav=[['/','Home'],['/menu','Food Menu'],['/drinks','Drinks'],['/banquets','Banquets & Events'],['/contact','Contact'],['/our-story','Our Story']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#4A3025"/><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content="/assets/og-image.png"/><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/><link rel="canonical" href={new URL(path,'https://www.hilltopct.net').href}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Gloock&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/><title>{title}</title><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Restaurant',name:'Hilltop Restaurant',address:{'@type':'PostalAddress',streetAddress:'39 Adamec Road',addressLocality:'Willington',addressRegion:'CT',addressCountry:'US'},url:'https://www.hilltopct.net'})}/></head><body><header class:list={["header", {"header-interior":path!=="/"}]} style={path!=="/" ? "background:#4A3025;color:#F7F4EE;border-bottom-color:#725446" : undefined}><a href="/" class="brand" aria-label="Hilltop homepage"><img src={path === "/" ? "/assets/hilltop-logo.svg" : "/assets/hilltop-logo-light.svg"} alt="Hilltop Restaurant Bar Banquet"/></a><nav aria-label="Main navigation">{nav.map(([href,label])=><a href={href} class:list={{active:path===href || (href!=='/' && path===href+'/')}}>{label}</a>)}</nav><div class="header-actions"><a href="/contact" class="order-btn" title="Ordering link coming soon">Order Online <span class="soon">Soon</span></a><button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav">☰</button></div></header><nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>{nav.map(([href,label])=><a href={href}>{label}</a>)}<a href="/contact">Order Online — Coming Soon</a></nav><main><slot/></main><footer><div class="footer-main container"><div><img src="/assets/hilltop-logo-light.svg" alt="Hilltop" class="footer-logo"/><p>From the garden. From the grill.</p></div><div><h3>Explore</h3>{nav.map(([href,label])=><a href={href}>{label}</a>)}</div><div><h3>Find Us</h3><p>39 Adamec Road<br/>Willington, CT</p><a href="https://www.google.com/maps/search/?api=1&query=39+Adamec+Road+Willington+CT" target="_blank" rel="noopener">Get Directions ↗</a><a href="mailto:hilltopbanquets@gmail.com">Banquet inquiries</a></div></div><div class="footer-bottom container"><span>© {new Date().getFullYear()} Hilltop Restaurant</span><span>Restaurant · Bar · Banquet</span></div></footer><script>const toggle=document.querySelector('.menu-toggle');const mobile=document.querySelector('#mobile-nav');toggle?.addEventListener('click',()=>{const expanded=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!expanded));mobile.hidden=expanded;});</script></body></html>
<style is:global>
/* V6: explicitly override Astro-scoped base header rules. */
header.header.header-interior { background:#4A3025 !important; color:#F7F4EE !important; border-bottom-color:#725446 !important; }
header.header.header-interior nav a { color:#F7F4EE !important; }
header.header.header-interior nav a.active,
header.header.header-interior nav a:hover { color:#ead8c5 !important; }
header.header.header-interior .order-btn { background:#F7F4EE !important; color:#4A3025 !important; border:1px solid #F7F4EE !important; }
header.header.header-interior .menu-toggle { color:#F7F4EE !important; }
header.header.header-interior + .mobile-nav { background:#4A3025 !important; color:#F7F4EE !important; }
header.header.header-interior + .mobile-nav a { border-bottom-color:#785b4f !important; }
</style>

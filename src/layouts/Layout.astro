---
import {site} from '../data/site.js';
const {title='Hilltop Restaurant · Bar · Banquet',description='A welcoming neighborhood restaurant, bar and banquet destination in Willington, Connecticut.'}=Astro.props;
const path=Astro.url.pathname;
const nav=[['/','Home'],['/menu','Food Menu'],['/drinks','Drinks'],['/banquets','Banquets & Events'],['/contact','Contact'],['/our-story','Our Story']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#4A3025"/><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content="/assets/og-image.png"/><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/><link rel="canonical" href={new URL(path,'https://www.hilltopct.net').href}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Gloock&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/><title>{title}</title><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Restaurant',name:'Hilltop Restaurant',address:{'@type':'PostalAddress',streetAddress:'39 Adamec Road',addressLocality:'Willington',addressRegion:'CT',addressCountry:'US'},url:'https://www.hilltopct.net'})}/></head><body><header class:list={["header", {"header-interior":path!=="/"}]}><a href="/" class="brand" aria-label="Hilltop homepage"><img src={path === "/" ? "/assets/hilltop-logo.svg" : "/assets/hilltop-logo-light.svg"} alt="Hilltop Restaurant Bar Banquet"/></a><nav aria-label="Main navigation">{nav.map(([href,label])=><a href={href} class:list={{active:path===href || (href!=='/' && path===href+'/')}}>{label}</a>)}</nav><div class="header-actions"><a href="/contact" class="order-btn" title="Ordering link coming soon">Order Online <span class="soon">Soon</span></a><button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav">☰</button></div></header><nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>{nav.map(([href,label])=><a href={href}>{label}</a>)}<a href="/contact">Order Online — Coming Soon</a></nav><main><slot/></main><footer><div class="footer-main container"><div><img src="/assets/hilltop-logo-light.svg" alt="Hilltop" class="footer-logo"/><p>From the garden. From the grill.</p></div><div><h3>Explore</h3>{nav.map(([href,label])=><a href={href}>{label}</a>)}</div><div><h3>Find Us</h3><p>39 Adamec Road<br/>Willington, CT</p><a href="https://www.google.com/maps/search/?api=1&query=39+Adamec+Road+Willington+CT" target="_blank" rel="noopener">Get Directions ↗</a><a href="mailto:hilltopbanquets@gmail.com">Banquet inquiries</a></div></div><div class="footer-bottom container"><span>© {new Date().getFullYear()} Hilltop Restaurant</span><span>Restaurant · Bar · Banquet</span></div></footer><script>const toggle=document.querySelector('.menu-toggle');const mobile=document.querySelector('#mobile-nav');toggle?.addEventListener('click',()=>{const expanded=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!expanded));mobile.hidden=expanded;});</script></body></html>
<style is:global>
:root{--espresso:#4A3025;--charcoal:#1E1E1E;--cream:#F7F4EE;--stone:#D6C8B6;--walnut:#8B6A50}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--charcoal);font:16px/1.65 'Instrument Sans',Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}h1,h2,h3,p{margin-top:0}h1,h2,.serif{font-family:Gloock,Georgia,serif;font-weight:400;line-height:1.16}h1{font-size:clamp(3rem,6vw,6rem);letter-spacing:-.035em}h2{font-size:clamp(2.1rem,4vw,3.9rem);letter-spacing:-.025em}h3{font-size:1.2rem}.container{width:min(1160px,calc(100% - 44px));margin:auto}.eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.2em;font-weight:700;color:var(--walnut)}.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--espresso);color:white;padding:14px 24px;border:1px solid var(--espresso);font-size:.82rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;transition:transform .2s,background .2s}.button:hover{background:#684435;transform:translateY(-2px)}.button-outline{background:transparent;color:var(--espresso)}.button-outline:hover{color:white}.button-light{background:var(--cream);border-color:var(--cream);color:var(--espresso)}.section{padding:95px 0}.section-heading{max-width:720px;margin-bottom:40px}.section-heading p{max-width:620px}.announcement{background:var(--espresso);color:var(--cream);text-align:center;font-size:.62rem;letter-spacing:.24em;padding:9px}.announcement span{opacity:.55;margin:0 9px}.header{background:var(--cream);display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px max(24px,calc((100vw - 1160px)/2));position:relative;z-index:5;border-bottom:1px solid #e5ded4}.brand img{display:block;width:195px;max-height:55px}.header nav{display:flex;gap:22px;align-items:center}.header nav a{font-size:.78rem;font-weight:600;white-space:nowrap}.header nav a.active,.header nav a:hover{color:var(--walnut)}.order-btn{display:block;padding:12px 16px;background:var(--espresso);color:white;font-size:.75rem;font-weight:700;white-space:nowrap}.soon{font-size:.6rem;opacity:.8;margin-left:6px}.menu-toggle{display:none;background:none;border:0;font-size:1.6rem;color:var(--espresso)}.mobile-nav{background:var(--cream);padding:16px 24px;border-bottom:1px solid var(--stone)}.mobile-nav a{display:block;padding:10px 0;border-bottom:1px solid #e8e0d5}.mobile-nav[hidden]{display:none}.page-hero .inner-page-crest{display:block;width:42px;height:42px;margin:0 0 22px 0}.page-hero{padding:92px 0 65px;background:#eee8df}.page-hero p{max-width:700px;font-size:1.08rem}.split{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.feature-card{padding:34px;background:white;border:1px solid #e7dfd4;min-height:270px}.feature-card h3{font-family:Gloock,Georgia,serif;font-size:1.65rem;font-weight:400}.photo-placeholder{min-height:380px;background:linear-gradient(140deg,#6c5143,#2c221f);display:flex;align-items:end;padding:26px;color:#fff9;font-size:.68rem;letter-spacing:.15em;text-transform:uppercase}.photo-placeholder.light{background:linear-gradient(135deg,#d7c7b4,#99806a)}.cta-band{background:var(--espresso);color:white;padding:75px 0}.cta-band h2{max-width:680px}.text-link{font-size:.8rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700;border-bottom:1px solid currentColor;padding-bottom:5px}.footer-main{display:grid;grid-template-columns:2fr 1fr 1fr;gap:55px;padding-top:75px;padding-bottom:70px}.footer-logo{width:240px}.footer-main a{display:block;margin-bottom:9px}.footer-main h3{font-size:.8rem;text-transform:uppercase;letter-spacing:.13em}.footer-main p{color:#d7c6ba}.footer-bottom{display:flex;justify-content:space-between;border-top:1px solid #76594c;padding:22px 0;font-size:.75rem;color:#dbc9bd}footer{background:var(--espresso);color:var(--cream)}.muted{color:#68615c}.chip{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;border:1px solid #cbbcac;padding:9px 13px;display:inline-block}.price{font-weight:700;color:var(--espresso);white-space:nowrap}.card-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.info-card{background:#fff;padding:28px;border:1px solid #e2d8cc}.info-card h3{font-family:Gloock,Georgia,serif;font-weight:400;font-size:1.6rem}.info-card .price{font-size:1.5rem}.small-note{font-size:.85rem;color:#5d554f}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{display:flex;flex-direction:column;gap:6px}.field label{font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.field input,.field textarea,.field select{width:100%;padding:13px;border:1px solid #bdb1a4;background:#fff;border-radius:0}.field.full{grid-column:1/-1}@media(max-width:1050px){.header nav{gap:12px}.header nav a{font-size:.7rem}.brand img{width:165px}}@media(max-width:850px){.header nav{display:none}.menu-toggle{display:block}.header{padding:13px 22px}.split{grid-template-columns:1fr;gap:28px}.feature-grid{grid-template-columns:1fr}.footer-main{grid-template-columns:1fr 1fr}.section{padding:65px 0}}@media(max-width:560px){.container{width:min(100% - 32px,1160px)}.announcement{font-size:.5rem;letter-spacing:.12em}.brand img{width:150px}.order-btn{font-size:.67rem;padding:10px}.soon{display:none}.page-hero .inner-page-crest{display:block;width:42px;height:42px;margin:0 0 22px 0}.page-hero{padding:60px 0 42px}.footer-main{grid-template-columns:1fr}.footer-bottom{gap:8px;flex-direction:column}.card-grid,.form-grid{grid-template-columns:1fr}.photo-placeholder{min-height:260px}h1{font-size:3rem}}
</style>

<style is:global>
/* V5: espresso header only on interior pages */
.announcement{display:none}
.header-interior{background:var(--espresso);border-bottom:1px solid #725446;color:var(--cream)}
.header-interior nav a{color:var(--cream)}
.header-interior nav a.active,.header-interior nav a:hover{color:#ead8c5}
.header-interior .order-btn{background:var(--cream);color:var(--espresso);border:1px solid var(--cream)}
.header-interior .menu-toggle{color:var(--cream)}
.header-interior + .mobile-nav{background:var(--espresso);color:var(--cream)}
.header-interior + .mobile-nav a{border-bottom-color:#785b4f}
@media(max-width:560px){.header-interior .brand img{width:150px}}
</style>
